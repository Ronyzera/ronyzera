{
  "name": "ronyzera",
  "version": "1.0.14",
  "description": "RONYZERA - voz, chat, tela e musica",
  "main": "main.js",
  "author": "RONY",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node test/run.js",
    "build": "electron-builder --win nsis --publish never",
    "publish": "electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.0"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^25.0.0",
    "jsdom": "^31.0.0"
  },
  "build": {
    "appId": "com.ronyzera.app",
    "productName": "RONYZERA",
    "files": [
      "main.js",
      "preload.js",
      "detectar-jogo-electron.js",
      "turn.js",
      "picker.html",
      "picker-preload.js",
      "index.html",
      "icon.ico",
      "vendor/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "ronyzera",
        "repo": "ronyzera",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
